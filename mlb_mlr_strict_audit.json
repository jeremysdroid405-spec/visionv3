    "sigma_source": "str - where sigma came from (TRUE_L10_CALCULATION, MLB_VOLATILITY_FLOOR_0.35)",
    "z_score": "float - (line - prediction) / sigma",
    "vk_prob_over": "float - probability of going OVER the line %",
    "vk_prob_under": "float - probability of going UNDER the line %",
    "vk_verdict": "str - STRONG_OVER, LEAN_OVER, NEUTRAL, LEAN_UNDER, STRONG_UNDER",
    "vk_edge": "float - vk_prob_over - implied_probability",
    "is_valid": "bool - True if prediction succeeded, False if BDL data missing",
    "error": "str or null - error message if is_valid=False"
  },
