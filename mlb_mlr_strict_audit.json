  "mlr_matchup_block_schema": {
    "splits": {
      "vs_lhp_avg": "float - batting average vs left-handed pitchers",
      "vs_rhp_avg": "float - batting average vs right-handed pitchers",
      "platoon_split": "float - rhp_avg - lhp_avg",
      "vs_lhp_k_rate": "float - strikeout rate vs LHP",
      "vs_rhp_k_rate": "float - strikeout rate vs RHP",
      "matchup_avg": "float - avg based on actual opposing pitcher hand",
      "matchup_slg": "float - slugging based on actual opposing pitcher hand"
    },
    "park": {
      "venue": "str - team abbreviation (e.g., COL, SF)",
      "factor": "float - park factor for specific stat type",
      "hits_factor": "float - park hits multiplier",
      "runs_factor": "float - park runs multiplier",
      "hr_factor": "float - park home run multiplier",
      "k_factor": "float - park strikeout multiplier"
    },
    "opponent": {
      "team": "str - opponent team abbreviation",
      "k_rate": "float - team strikeout tendency"
    },
    "trends": {
      "l5_avg": "float - last 5 games average",
      "l10_avg": "float - last 10 games average",
      "ewma_l10": "float - exponentially weighted L10 average",
      "momentum": "float - (ewma_l5 - ewma_l10) / ewma_l10"
    },
    "variance": {
      "std_l10": "float - TRUE L10 standard deviation",
      "cv_l10": "float - coefficient of variation L10"
    },
    "discipline": {
      "contact_rate": "float - 1 - overall_k_rate",
      "bb_k_ratio": "float - walk rate / strikeout rate",
      "power_index": "float - (slg - avg) * contact_rate"
    }
  },
  "market_data_block_schema": {
    "dk_odds": "int - DraftKings American odds",
    "implied_probability": "float - market implied probability %"
  },
  "output_schema": {
    "mlr_predicted": "float - HIGH PRECISION prediction (e.g., 0.96, 4.38)",
